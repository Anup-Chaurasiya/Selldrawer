{% comment %}
  Upsellity Cart Drawer - App Embed
  This app embed enables the cart drawer functionality
  Configuration is managed in extensions/cart-upsell/config.js
{% endcomment %}

<div data-upsellity-cart-drawer></div>

<script>
  (function() {
    // Load the cart drawer CSS
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.type = 'text/css';
    link.href = '{{ 'cart-drawer.css' | asset_url }}';
    document.head.appendChild(link);
    
    // Load the cart drawer script
    var script = document.createElement('script');
    script.src = '{{ 'cart-drawer.js' | asset_url }}';
    script.async = true;
    document.head.appendChild(script);
  })();
</script>

{% schema %}
{
  "name": "Upsellity Cart Drawer",
  "target": "body",
  "settings": []
}
{% endschema %}

