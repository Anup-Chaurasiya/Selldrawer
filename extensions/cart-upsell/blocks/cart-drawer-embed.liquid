{% comment %}
  Selldrawer Cart Drawer - App Embed
  This app embed enables the cart drawer functionality
{% endcomment %}

<div data-selldrawer-app-url="{{ block.settings.app_url }}"></div>

<script>
  (function() {
    // Set config BEFORE loading the script so it's available immediately
    window.selldrawer_config = {
      customerId: "{{ customer.id | default: '' }}",
      shop: "{{ shop.permanent_domain }}"
    };
    
    // Add timestamp for cache busting during development
    var timestamp = new Date().getTime();
    var cacheParam = '?t=' + Math.floor(timestamp / 60000); // Update every minute
    
    // Load the cart drawer CSS
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.type = 'text/css';
    link.href = '{{ 'cart-drawer.css' | asset_url }}' + cacheParam;
    document.head.appendChild(link);
    
    // Load the cart drawer script
    var script = document.createElement('script');
    script.src = '{{ 'cart-drawer.js' | asset_url }}' + cacheParam;
    script.async = true;
    document.head.appendChild(script);
  })();
</script>

{% schema %}
{
  "name": "Selldrawer Cart Drawer",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "info": "Enter your Selldrawer app URL (e.g., https://your-app.fly.dev)",
      "default": "https://app.selldrawer.com"
    }
  ]
}
{% endschema %}
