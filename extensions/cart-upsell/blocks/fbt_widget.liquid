{% comment %}
  Frequently Bought Together Widget
  Displays product bundles on product pages
  Configuration is managed in extensions/cart-upsell/config.js
{% endcomment %}

<script>
  (function() {
    // Load the FBT widget CSS
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.type = 'text/css';
    link.href = '{{ 'fbt-widget.css' | asset_url }}';
    document.head.appendChild(link);
    
    // Load the FBT widget script
    var script = document.createElement('script');
    script.src = '{{ 'fbt-widget.js' | asset_url }}';
    script.async = true;
    document.head.appendChild(script);
  })();
</script>

<div 
  class="selldrawer-fbt-widget selldrawer-fbt-container"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
>
  <div class="selldrawer-fbt-loading">
    <div class="selldrawer-fbt-spinner"></div>
    <p>Loading recommendations...</p>
  </div>
</div>

{% schema %}
{
  "name": "FBT Widget",
  "target": "section",
  "settings": []
}
{% endschema %}

