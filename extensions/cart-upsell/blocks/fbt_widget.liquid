{% comment %}
  Frequently Bought Together Widget
  Displays product bundles on product pages
{% endcomment %}

{{ 'fbt-widget.css' | asset_url | stylesheet_tag }}

{% comment %} Get app URL from settings or use default {% endcomment %}
{% if block.settings.app_url != blank %}
  {% assign app_url = block.settings.app_url %}
{% else %}
  {% assign app_url = "https://app.upsellity.com" %}
{% endif %}

<div 
  class="upsellity-fbt-widget upsellity-fbt-container"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-app-url="{{ app_url }}"
>
  <div class="upsellity-fbt-loading">
    <div class="upsellity-fbt-spinner"></div>
    <p>Loading recommendations...</p>
  </div>
</div>

<script src="{{ 'fbt-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FBT Widget",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Widget Title",
      "default": "Frequently Bought Together"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Widget",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.upsellity.com",
      "info": "The URL of your Upsellity app (leave default if unsure)"
    }
  ]
}
{% endschema %}

