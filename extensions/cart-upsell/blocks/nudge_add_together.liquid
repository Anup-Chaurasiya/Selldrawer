{% comment %}
  Nudge Add Together Widget
  Shows additional products in a popup when "Add to Cart" is clicked
  Customers can select multiple products via checkboxes and add them together with the original product
  Configuration is managed in extensions/cart-upsell/config.js
{% endcomment %}

{% comment %} Add meta tag for shop domain {% endcomment %}
<meta name="shopify-shop" content="{{ shop.permanent_domain }}">

<script>
  (function() {
    // Load the Nudge Add Together script
    var script = document.createElement('script');
    script.src = '{{ 'nudge-add-together.js' | asset_url }}';
    script.async = true;
    document.head.appendChild(script);
  })();
</script>

{% schema %}
{
  "name": "Nudge Cross Sell",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This widget shows additional product recommendations in a popup when customers click 'Add to Cart'. Customers can select multiple products using checkboxes and add them together with the original product. Configure the popup settings in the Upsellity admin panel."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Nudge Add Together",
      "default": true,
      "info": "You can also enable/disable from the Upsellity admin panel"
    }
  ]
}
{% endschema %}

