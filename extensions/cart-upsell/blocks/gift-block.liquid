{% comment %}
  Gifting Block - Shopify Theme Extension
  Displays free gift offers when customers meet certain conditions
  
  Settings:
  - Block enable/disable
  - Container styling
{% endcomment %}

{% comment %} Only render if enabled {% endcomment %}
{% if block.settings.enabled %}
  <div
    class="upsellity-gifting-container"
    data-shop="{{ shop.permanent_domain }}"
    id="upsellity-gifting-{{ block.id }}"
    style="margin: {{ block.settings.margin_top }}px {{ block.settings.margin_right }}px {{ block.settings.margin_bottom }}px {{ block.settings.margin_left }}px; padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px; background-color: {{ block.settings.background_color }}; border-radius: {{ block.settings.border_radius }}px; {% if block.settings.custom_css %}{{ block.settings.custom_css }}{% endif %}"
  >
    <!-- JavaScript will mount the React component here -->
  </div>

  <!-- Load the gifting block JavaScript with cache busting -->
  <script>
    (function() {
      var version = '1.0.11';
      var timestamp = new Date().getTime();
      var cacheParam = '?v=' + version + '&t=' + Math.floor(timestamp / 60000);
      
      var script = document.createElement('script');
      script.src = '{{ 'gift-block.js' | asset_url }}' + cacheParam;
      script.defer = true;
      document.head.appendChild(script);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Gifting Block",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Gifting Block",
      "default": true,
      "info": "Toggle to show/hide the gifting block"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin right",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 16
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Add custom CSS styles (without <style> tags)"
    }
  ]
}
{% endschema %}
