{% comment %}
  Nudge Popup Widget
  Shows alternative products in a popup when "Add to Cart" is clicked
  Built with React and bundled via esbuild
{% endcomment %}

{% comment %} Get app URL from settings or use default {% endcomment %}
{% if block.settings.app_url != blank %}
  {% assign app_url = block.settings.app_url %}
{% else %}
  {% assign app_url = "https://app.upsellity.com" %}
{% endif %}

{% comment %} Add meta tag for shop domain {% endcomment %}
<meta name="shopify-shop" content="{{ shop.permanent_domain }}">

<script>
  (function() {
    // Version number for cache busting
    var version = '{{ block.settings.version | default: "1.0.2" }}';
    var appUrl = '{{ app_url }}';
    
    // Load the Nudge Popup script
    var script = document.createElement('script');
    script.src = '{{ 'nudge-popup.js' | asset_url }}' + '?v=' + version;
    script.async = true;
    script.setAttribute('data-nudge-app-url', appUrl);
    document.head.appendChild(script);
  })();
</script>

{% schema %}
{
  "name": "Nudge Popup",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This widget shows alternative product recommendations in a popup when customers click 'Add to Cart'. Configure the popup settings in the Upsellity admin panel."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Nudge Popup",
      "default": true,
      "info": "You can also enable/disable from the Upsellity admin panel"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.upsellity.com",
      "info": "The URL of your Upsellity app (leave default if unsure)"
    },
    {
      "type": "text",
      "id": "version",
      "label": "Version",
      "info": "Version number for cache busting. Update this when you release new versions.",
      "default": "1.0.2"
    }
  ]
}
{% endschema %}

